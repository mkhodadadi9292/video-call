# Copy to .env and adjust. Used by docker compose for port/secret configuration.

# Jitsi JWT (must match between backend and jitsi-prosody)
JITSI_JWT_APP_ID=video-call-system
JITSI_JWT_SECRET=change-me-in-production-use-a-long-random-string
JITSI_JWT_EXPIRE_MINUTES=1440

# Host ports (change if MediaService or anything else occupies 80/443/8443/10000)
HTTP_PORT=80
HTTPS_PORT=443
JITSI_WEB_PORT=8443
JVB_PORT=10000

# Must match the TLS cert SANs (see scripts/gen-certs.sh)
JITSI_PUBLIC_URL=https://192.168.1.37:8443
